#!/usr/bin/env sh
set -eu

echo "[pre-commit] Running CI static analysis with Java 21"

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ -n "${JAVA_HOME_21:-}" ] && [ -x "$JAVA_HOME_21/bin/java" ]; then
    export JAVA_HOME="$JAVA_HOME_21"
    export PATH="$JAVA_HOME/bin:$PATH"
elif [ -n "${JAVA_HOME_21_X64:-}" ] && [ -x "$JAVA_HOME_21_X64/bin/java" ]; then
    export JAVA_HOME="$JAVA_HOME_21_X64"
    export PATH="$JAVA_HOME/bin:$PATH"
fi

if ! command -v java >/dev/null 2>&1; then
    echo "[pre-commit] java was not found on PATH."
    echo "[pre-commit] Set JAVA_HOME or JAVA_HOME_21 to a JDK 21 install and retry."
    exit 1
fi

if ! command -v mvn >/dev/null 2>&1; then
    echo "[pre-commit] mvn was not found on PATH."
    exit 1
fi
mvn_command="$(command -v mvn)"
if [ -f "${mvn_command}.cmd" ]; then
    mvn_command="${mvn_command}.cmd"
fi

java_major=""
while IFS= read -r line; do
    case "$line" in
        *"java.specification.version = "*)
            java_major="${line##*java.specification.version = }"
            break
            ;;
    esac
done <<EOF
$(java -XshowSettings:properties -version 2>&1)
EOF

case "$java_major" in
    21*) ;;
    *)
    echo "[pre-commit] Java 21 is required to mirror the CI static analysis check."
    echo "[pre-commit] Current java.specification.version is '$java_major'."
    echo "[pre-commit] Set JAVA_HOME or JAVA_HOME_21 to a JDK 21 install and retry."
    java -version
    exit 1
        ;;
esac

"$mvn_command" -B -DskipTests verify
